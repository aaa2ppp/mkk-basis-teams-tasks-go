# ============================================
# Настройки логирования
# ============================================

# Уровень детализации логов
# Допустимые значения: DEBUG, INFO, WARN, ERROR
# По умолчанию: INFO
#LOG_LEVEL=INFO

# Выводить логи в человекочитаемом формате вместо JSON
# Допустимые значения: yes / no (или true / false)
# По умолчанию: no (JSON)
#LOG_PLAINTEXT=no


# ============================================
# Настройки HTTP-сервера
# ============================================

# Адрес и порт, на котором сервер будет принимать запросы
# Формат: host:port, где host может быть пустым (":8080")
# NOTE: Для Docker переопределено в docker-compose.yml
SERVER_ADDR=localhost:8080

# Таймаут чтения запроса (от получения соединения до полного чтения тела)
# Формат: число + единица (s - секунды, m - минуты, ms - миллисекунды)
# По умолчанию: 5s
#SERVER_READ_TIMEOUT=5s

# Таймаут записи ответа (от начала отправки заголовков до завершения ответа)
# По умолчанию: 5s
#SERVER_WRITE_TIMEOUT=5s

# Общий таймаут обработки запроса (от чтения до отправки ответа)
# Должен быть больше или равен READ_TIMEOUT + WRITE_TIMEOUT
# По умолчанию: 5s
#SERVER_REQUEST_TIMEOUT=5s

# Таймаут корректного завершения работы сервера при получении сигнала остановки
# За это время сервер должен завершить все активные запросы
# По умолчанию: 10s
#SERVER_SHUTDOWN_TIMEOUT=10s

# Максимальное количество запросов в секунду с одного IP-адреса
# По умолчанию: 30
#RATE_LIMIT=30


# ============================================
# Подключение к базе данных
# ============================================

# Адрес и порт БД в формате host:port
# NOTE: Для Docker переопределено в docker-compose.yml
DB_ADDR=localhost:3306

# Имя базы данных
# По умолчанию: app-db
#DB_NAME=app-db

# Имя пользователя БД
# По умолчанию: app-user
#DB_USER=app-user

# Пароль пользователя БД (ОБЯЗАТЕЛЬНЫЙ)
# !!! Сгенерируйте надёжный пароль, не используйте значения по умолчанию !!!
#DB_PASSWORD='your strong password (REQUIRED)'


# ============================================
# Circuit Breaker для БД
# ============================================

# Размер окна сбора статистики.
# По умолчанию: 60s
#DB_CB_WINDOW_INTERVAL=60s

# Размер корзины для скользящего окна. Если <= 0 - не используется.
# По умолчанию: 10s
#DB_CB_BUCKET_PERIOD=10s

# Время ожидания в открытом состоянии перед переходом в полуоткрытое для проверки.
# По умолчанию: 30s
#DB_CB_OPEN_TIMEOUT=30s

# Максимальное количество проверочных запросов, пропускаемых в полуоткрытом состоянии.
# Если все они успешны – цепь закрывается; если хотя бы один упал – снова открывается.
# Если <= 0, то выполняется одна попытка. 
# По умолчанию: 3
#DB_CB_HALFOPEN_MAX_REQ=3

# Минимальное количество запросов, которое должно накопиться в окне,
# чтобы мы начали оценивать долю ошибок (защита от ложных срабатываний при малом трафике).
# По умолчанию: 10
#DB_CB_WINDOW_MIN_REQ=10

# Доля ошибок (0.0–1.0), при превышении которой цепь размыкается.
# Например, 0.5 означает 50% ошибок.
# По умолчанию: 0.5
#DB_CB_FAILURE_RATIO=0.5


# ============================================
# Настройки аутентификации
# ============================================

# Секрет для генерации токена (ОБЯЗАТЕЛЬНЫЙ)
#AUTH_SECRET='exactly 32 byte in hex-string (REQUIRED)'

# Заголовок токена
#AUTH_TOKEN_HEADER=X-Authtoken

# Время жизни токена
#AUTH_TOKEN_LIFETIME=15m


# ============================================
# Настройки Redis
# ============================================

# Адрес и порт в формате host:port
# NOTE: Для Docker переопределено в docker-compose.yml
REDIS_ADDR=localhost:6379

# Пароль (ОБЯЗАТЕЛЬНЫЙ)
#REDIS_PASSWORD='your strong password (REQUIRED)'

# Таймаут подключения (в секундах)
#REDIS_TIMEOUT=5s


# ============================================
# Настройки кеша
# ============================================

#CACHE_TASKS_TTL=5m
